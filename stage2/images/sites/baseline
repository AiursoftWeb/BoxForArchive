{
	email anduin@aiursoft.com

	# DNS challenge timing belongs to the ACME issuer, not the DNS provider.
	cert_issuer acme {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
		# Skip the local precheck; the CA still verifies the public TXT record.
		propagation_timeout -1ns
		propagation_delay 60s
	}
	cert_issuer acme {
		dir https://acme.zerossl.com/v2/DV90
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
		propagation_timeout -1ns
		propagation_delay 60s
	}

	servers :443 {
		import cloudflare_trust

		listener_wrappers {
			http_redirect
			tls
		}
	}
}

(hsts) {
	header Strict-Transport-Security max-age=63072000
}
