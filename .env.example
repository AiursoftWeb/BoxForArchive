REGISTRY_HOST=pubhub.aiursoft.com
REGISTRY_VERIFICATION_IMAGE=caddy:latest
REGISTRY_USERNAME=YOUR_REGISTRY_USERNAME
REGISTRY_PASSWORD=YOUR_REGISTRY_PASSWORD

# Restricted Cloudflare token used only for ACME DNS-01 challenges.
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN

PEERTUBE_POSTGRES_PASSWORD=YOUR_PEERTUBE_POSTGRES_PASSWORD
PEERTUBE_SECRET=YOUR_PEERTUBE_SECRET

# Restricted Cloudflare R2 token for the AnduinOS offline update publisher,
# limited to the anduinos-offline-updates bucket.
OFFLINE_BUNDLES_R2_ACCESS_KEY=YOUR_OFFLINE_BUNDLES_R2_ACCESS_KEY
OFFLINE_BUNDLES_R2_SECRET_KEY=YOUR_OFFLINE_BUNDLES_R2_SECRET_KEY
